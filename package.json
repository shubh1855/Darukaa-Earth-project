{
  "name": "darukaa-earth",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "scripts": {
    "prepare": "husky",
    "lint": "npm --prefix frontend run lint",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css,json,md}\" docs/**/*.md",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css,json,md}\" docs/**/*.md",
    "test:backend": "python -m pytest backend/tests",
    "quality": "npm run lint && npm run format:check && npm run test:backend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "frontend/**/*.{css,json,md}": ["prettier --write"],
    "docs/**/*.md": ["prettier --write"],
    "backend/**/*.py": ["ruff check --fix", "ruff format"]
  }
}
